#!/bin/bash
# Proteuse - Playwright UI Test Execution
# Usage: proteuse -testc <path-to-test-cases.xlsx>

# Find Maven wrapper or use system mvn
if [ -f "mvnw" ]; then
    MVN_CMD=./mvnw
else
    MVN_CMD=mvn
fi

# Execute with all arguments passed through
$MVN_CMD compile exec:java -Dexec.mainClass="ui_adapter.Main" -Dexec.args="$*" -q
